{
  "lspServers": {
    "typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio"],
      "fileExtensions": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact"
      }
    },
    "python": {
      "command": "pyright-langserver",
      "args": ["--stdio"],
      "fileExtensions": {
        ".py": "python"
      }
    },
    "rust": {
      "command": "rust-analyzer",
      "args": [],
      "fileExtensions": {
        ".rs": "rust"
      }
    },
    "java": {
      "command": "jdtls",
      "args": [],
      "fileExtensions": {
        ".java": "java"
      }
    },
    "kotlin": {
      "command": "kotlin-lsp",
      "args": ["--stdio"],
      "fileExtensions": {
        ".kt": "kotlin",
        ".kts": "kotlin"
      }
    },
    "terraform": {
      "command": "terraform-ls",
      "args": ["serve"],
      "fileExtensions": {
        ".tf": "terraform",
        ".tfvars": "terraform-vars"
      }
    },
    "helm": {
      "command": "helm_ls",
      "args": ["serve"],
      "fileExtensions": {
        ".tpl": "helm"
      }
    },
    "yaml": {
      "command": "yaml-language-server",
      "args": ["--stdio"],
      "fileExtensions": {
        ".yaml": "yaml",
        ".yml": "yaml"
      }
    },
    "go": {
      "command": "gopls",
      "args": ["serve"],
      "initializationOptions": {
        "templateExtensions": ["tmpl", "gotmpl"]
      },
      "fileExtensions": {
        ".go": "go",
        ".tmpl": "gotmpl",
        ".gotmpl": "gotmpl"
      }
    }
  }
}

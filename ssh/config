# Machine-specific hosts that must not leak into this public repo
Include ~/.ssh/config.local

Host *
    ServerAliveInterval 120
    ServerAliveCountMax 60
    TCPKeepAlive yes
    # Load keys into ssh-agent on first use, and read/store their passphrases
    # in the macOS login Keychain so they survive a reboot.
    AddKeysToAgent yes
    UseKeychain yes

# Public GitHub. Identity is selected by checkout location so remotes can stay
# on github.com, which keeps IDE GitHub integrations working.
Host github.com
    HostName github.com
    User git
    IdentitiesOnly yes

# Personal GitHub repos live under ~/dev.
Match host github.com exec "case \"$(pwd -P)\" in \"$HOME\"/dev|\"$HOME\"/dev/*) exit 0;; *) exit 1;; esac"
    IdentityFile ~/.ssh/id_personal

# Adobe GitHub repos live under ~/work/adobe.
Match host github.com exec "case \"$(pwd -P)\" in \"$HOME\"/work/adobe|\"$HOME\"/work/adobe/*) exit 0;; *) exit 1;; esac"
    IdentityFile ~/.ssh/id_adobe

# Personal GitHub fallback alias for explicit tests or repos outside ~/dev.
Host github-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_personal
    IdentitiesOnly yes

# Adobe internal GitHub
Host git.corp.adobe.com
    HostName git.corp.adobe.com
    User git
    IdentityFile ~/.ssh/id_corp
    IdentitiesOnly yes
